# dipendenze
node_modules

# output di build del frontend (Vite)
/dist

# scaffale: preferenza di vista personale (run.json invece è condiviso)
.orbit/shelf.json

# scratchpad: note/prompt personali (file di lavoro, non condiviso)
.orbit/scratch.md

# indice simboli: cache generata della "rubrica" del codice (per-macchina)
.orbit/index/

# sistema
.DS_Store
Thumbs.db

# env
.env
.env.*
!.env.example

# timestamp temporanei di Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# build Rust/Tauri: vedi anche src-tauri/.gitignore

# icone mobile generate da `tauri icon` (progetto desktop, non servono)
src-tauri/icons/android/
src-tauri/icons/ios/
