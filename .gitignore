# dipendenze
node_modules

# output di build del frontend (Vite)
/dist

# File .orbit/ personali o generati — `**/` così valgono anche per cartelle aperte ANNIDATE in questo
# repo (es. docs/.orbit/index/): senza `**/` lo slash interno àncora il pattern alla sola root.
# (run.json e claude.json NON sono ignorati: condivisi/committati.)
# scaffale: preferenza di vista personale
**/.orbit/shelf.json
# scratchpad: note/prompt personali (file di lavoro, non condiviso)
**/.orbit/scratch.md
# indice simboli: cache generata della "rubrica" del codice (per-macchina)
**/.orbit/index/

# sistema
.DS_Store
Thumbs.db
# crash dump di Git Bash/Cygwin (comparsi durante lo sviluppo, mai da committare)
*.stackdump

# env
.env
.env.*
!.env.example

# timestamp temporanei di Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# build Rust/Tauri: vedi anche src-tauri/.gitignore

# icone mobile generate da `tauri icon` (progetto desktop, non servono)
src-tauri/icons/android/
src-tauri/icons/ios/
