{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability per la finestra principale e per il terminale flottante",
  "windows": ["main", "term-float"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus"
  ]
}
