{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit",
  "version": "1.6.0",
  "identifier": "com.visialab.lume",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Orbit",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "theme": "Dark",
        "visible": false,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#16181d",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A lightweight IDE, companion for Claude Code",
    "longDescription": "Orbit is a lightweight, beautiful IDE built as a companion for Claude Code: edit code, browse the project, manage git, and keep Claude Code running in an integrated terminal, with side-by-side chats, an Activity timeline of what Claude did and a Shelf for the folders you don't need to see.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "txt", "md", "markdown", "log", "json", "jsonc", "yaml", "yml", "toml", "ini",
          "conf", "csv", "xml", "html", "htm", "css", "scss", "sass", "less", "js", "mjs",
          "cjs", "jsx", "ts", "mts", "cts", "tsx", "svelte", "vue", "py", "rs", "go", "java",
          "c", "h", "cpp", "hpp", "cs", "rb", "php", "sql",
          "png", "jpg", "jpeg", "gif", "webp", "bmp", "svg", "pdf"
        ],
        "name": "Orbit document",
        "description": "Open in Orbit",
        "role": "Editor"
      }
    ],
    "linux": {
      "deb": {
        "section": "devel",
        "desktopTemplate": "./linux/orbit.desktop"
      },
      "rpm": {
        "desktopTemplate": "./linux/orbit.desktop"
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1RjUzNjFBRkE2OTUwMjkKUldRcFVHbjZHamIxVmFTVWlta2RTZHF6cEdTOG1yandmTERIQ3Y0dkNMeDRlS3I5Vk4wRUdGRGYK",
      "endpoints": ["https://github.com/caste9612/Orbit/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
