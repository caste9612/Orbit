{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit",
  "version": "0.8.8",
  "identifier": "com.visialab.lume",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Orbit",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "theme": "Dark",
        "visible": false,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#16181d",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "txt", "md", "markdown", "log", "json", "jsonc", "yaml", "yml", "toml", "ini",
          "conf", "csv", "xml", "html", "htm", "css", "scss", "sass", "less", "js", "mjs",
          "cjs", "jsx", "ts", "mts", "cts", "tsx", "svelte", "vue", "py", "rs", "go", "java",
          "c", "h", "cpp", "hpp", "cs", "rb", "php", "sql", "sh", "bash", "ps1", "bat", "cmd",
          "png", "jpg", "jpeg", "gif", "webp", "bmp", "svg", "pdf"
        ],
        "name": "Orbit document",
        "description": "Open in Orbit",
        "role": "Editor"
      }
    ]
  }
}
